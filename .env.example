# Neon Postgres connection string (Vercel → Storage → Neon adds it as DATABASE_URL)
DATABASE_URL=
OPENAI_API_KEY=
# Optional: vision model that names each dress (default gpt-5.4-mini)
OPENAI_NAMING_MODEL=
# ImageKit dashboard → Developer options
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
# Optional: root folder on ImageKit (default backdrop-studio)
IMAGEKIT_FOLDER=
