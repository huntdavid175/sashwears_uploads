# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# impeccable: review screenshots, engine binary (re-downloaded on first run), caches,
# decision-page logs, and catalog reference images copied from impeccable.style
/.impeccable/review/
/.impeccable/hook.cache.json
/.impeccable/questions/
/.impeccable/mocks/refs/
/.claude/skills/impeccable/scripts/bin/

# typescript
*.tsbuildinfo
next-env.d.ts

# local app data (templates, uploads, outputs)
/data
!.env.example
